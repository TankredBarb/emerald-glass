file(MAKE_DIRECTORY "${WORKDIR}")
set(input "${WORKDIR}/input.png")
# These editor pages do not load the optional wallpaper; its bytes must survive.
file(WRITE "${input}" "preserve this input image\n")
file(SHA256 "${input}" before)
foreach(mode settings text-settings)
    set(output "${WORKDIR}/${mode}.png")
    execute_process(COMMAND "${PREVIEW}" "--${mode}" "${input}" "${output}"
        RESULT_VARIABLE result ERROR_VARIABLE diagnostics TIMEOUT 15)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "${mode} preview failed: ${result}\n${diagnostics}")
    endif()
    file(SHA256 "${input}" after)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "${mode} overwrote its input image")
    endif()
    if(NOT EXISTS "${output}")
        message(FATAL_ERROR "${mode} did not save the requested screenshot")
    endif()
    file(READ "${output}" signature LIMIT 8 HEX)
    if(NOT signature STREQUAL "89504e470d0a1a0a")
        message(FATAL_ERROR "${mode} did not produce a PNG screenshot")
    endif()
endforeach()
